# Copy to .env (same directory) before `docker compose up`. Do not commit .env.
#
# Generate values with:
#   openssl rand -base64 32

# ArangoDB root password. NOTE: on an existing data volume the Docker image
# ignores this env var — set the password once via arangosh:
#   arangosh --server.endpoint tcp://127.0.0.1:8529 --server.username root --server.password "" \
#     --javascript.execute-string 'require("@arangodb/users").update("root", "<value>")'
ARANGO_ROOT_PASSWORD=

# Auth.js session-cookie signing secret (openssl rand -base64 32)
AUTH_SECRET=
