# Copy to .env (same directory) before `docker compose up`. Do not commit .env.
#
# Generate values with:
#   openssl rand -base64 32
#
# Both keys below are REQUIRED — docker-compose.yml declares them as
# ${VAR:?set in compose/.env}, so `up` fails fast rather than starting half-configured.

# Postgres superuser password for the learnhub database (the one datastore).
POSTGRES_PASSWORD=

# Auth.js session-cookie signing secret.
AUTH_SECRET=
